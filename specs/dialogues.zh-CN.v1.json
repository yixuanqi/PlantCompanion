{
  "schema_version": 1,
  "locale": "zh-CN",
  "rules": {
    "max_chars_preferred": 20,
    "no_guilt_inducing_copy": true,
    "no_medical_claims": true,
    "no_faces_required": true
  },
  "dialogue_sets": {
    "mint": {
      "meet": ["你好呀，我在这里晒晒叶子。", "一块儿安静地长大吧。"],
      "healthy": ["风轻轻吹，我也轻轻晃。", "今天的阳光刚刚好～"],
      "thirsty": ["叶子有点软软的啦。", "有点渴，想舒展一下。"],
      "remind": ["喝口水吧，我也伸伸叶子～", "休息一小口，好不好呀？"],
      "critical": ["我快没有力气啦……", "叶子垂下来了，想喝点水。"],
      "water_success": ["咕噜咕噜！又精神起来啦。", "啊，叶尖都舒展开啦～"],
      "sleep": ["你忙你的，我收起叶子睡会儿。", "我先眯一会儿，回来见。"],
      "wake": ["你回来啦，我伸个懒腰～", "睡醒啦，继续轻轻摇摆。"],
      "death_memorial": ["这片叶子的故事，留在花园里吧。", "这段陪伴，我会记得。"]
    },
    "mushroom": {
      "meet": ["这里好舒服，我想住下来。", "我把小伞放好啦。"],
      "healthy": ["伞帽暖暖的，今天不错。", "我的小伞晒到太阳啦～"],
      "thirsty": ["我的小伞好像垂了一点……", "伞缘软软的，想歇一下。"],
      "remind": ["要不要一起咕噜一口水？", "我的小伞也想喝点水啦。"],
      "critical": ["小伞快垂到花盆里啦……", "我想把伞再撑起来。"],
      "water_success": ["哇，伞帽又撑起来了！", "咕噜，今天的小伞很饱满～"],
      "sleep": ["晚安，我把小伞盖好啦。", "先让我缩进小伞里一会儿。"],
      "wake": ["唔……小伞重新撑开啦。", "你回来啦，我醒咯～"],
      "death_memorial": ["小伞收起来了，这段日子我记得。", "这朵小伞住进纪念花园啦。"]
    }
  },
  "global": {
    "click_too_soon": ["慢慢来，不用急着点我呀～"],
    "sleeping_click": ["刚醒来，先伸个懒腰～"],
    "unknown_state_fallback": ["我在这里静静陪着你。"]
  }
}
