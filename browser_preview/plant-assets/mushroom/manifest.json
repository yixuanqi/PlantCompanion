  "stages": [
    "healthy",
    "thirsty",
    "dry",
    "critical",
    "dead",
    "sleep"
  ],
  "layers": [
    "pot",
    "stalk",
    "cap",
    "foliage"
  ],
  "canvas": [
    694,
    736
  ],
  "runtime": "plant-assets/mushroom/{stage}/{layer}.png",
  "states": "plant-assets/mushroom/states/{stage}.png",
  "idle": {
    "pot": "static",
    "stalk": "subtle",
    "cap": "subtle",
    "foliage": "subtle"
  },
  "dead": "static-no-revival",
  "preserve_original": true
}